{
	"schemaVersion": 1,
	"id": "allstackablecontinued",
	"version": "${version}",
	"name": "AllStackableContinued",
	"description": "An updated version of AllStackable, a highly customizable Minecraft Fabric Mod that makes items stackable and changes their stack size.",
	"authors": [
		"connlost",
		"MylesGit"
	],
	"contact": {
		"homepage": "",
		"sources": "https://github.com/MylesGit/AllStackableContinued",
		"issues": "https://github.com/MylesGit/AllStackableContinued/issues"
	},
	"license": "GPL-3.0",
	"icon": "assets/allstackable/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"online.connlost.allstackable.AllStackable"
		],
		"client": [
			"online.connlost.allstackable.AllStackableClient"
		]
	},
	"mixins": [
		"allstackable.mixins.json",
		{
			"config": "allstackable.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}